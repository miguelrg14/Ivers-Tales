<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Builds the engine-independent game logic outside Unity so it can be unit tested
    with the regular .NET tooling. The sources live inside the Unity project
    (Assets/_Project/Scripts/Core), where Unity compiles them as the
    IversTales.Core assembly; this project only links them.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>IversTales.Core</RootNamespace>
    <AssemblyName>IversTales.Core</AssemblyName>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../IversTales/Assets/_Project/Scripts/Core/**/*.cs" LinkBase="Core" />
  </ItemGroup>
</Project>
