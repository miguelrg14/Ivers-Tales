+    public Vector3 averagePositions
+    {
+        get
+        {
+            Vector3 average = Vector3.zero;
+            foreach (Vector3 velocity in historicalPositions)
+                average += velocity;
+            average.y = 0;
+            Vector3 result = average / historicalPositions.Count;
+
+            if (!double.IsNaN(result.x) || !double.IsNaN(result.y) || !double.IsNaN(result.z)) //checks if the result is not nan, because in the first frame it is due to the queue is not created
+                return average / historicalPositions.Count;
+            else
+                return Vector3.zero;
+        }
+    }
 
